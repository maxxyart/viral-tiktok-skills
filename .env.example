# Social skills REST fallback; export to environment (no automatic .env loading).
# MCP/authenticated CLI can supply credentials separately. Also used by legacy tools.
# Get a key at https://scrapecreators.com
SCRAPE_CREATORS_API_KEY=

# For carousel-account-patterns and legacy hook-analysis FAST mode.
# New social-account-hook-analysis needs no external vision key.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: automatic fallback when Gemini is unavailable (e.g. geo-blocked)
# Get a key at https://console.x.ai
XAI_API_KEY=

# Optional tuning — defaults are sensible, uncomment to override
# SCRAPER_CONCURRENCY=1
# SCRAPER_INTERVAL_CAP=2
# SCRAPER_INTERVAL_MS=1000
# SCRAPER_REQUEST_TIMEOUT_MS=30000
