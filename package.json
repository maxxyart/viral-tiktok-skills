{
  "name": "viral-tiktok-skills",
  "version": "2.0.0",
  "description": "Viral Camp skills for Instagram and TikTok account metrics, visual hook research, and carousel workflows.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "social:collect": "python3 src/social/social.py collect",
    "social:analyze": "python3 src/social/social.py analyze",
    "test:social": "python3 -m unittest discover -s tests -v",
    "package:skills": "python3 tools/package_social_skills.py",
    "legacy:short-analysis": "tsx src/scripts/quick-stats.ts",
    "legacy:hook-analysis": "tsx src/scripts/analyze-cover-hooks.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.13.5",
    "dotenv": "^17.3.1",
    "p-queue": "^9.1.0",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
